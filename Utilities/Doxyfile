# =============================================================================
# DOXYGEN INTERNAL COMMENTS TROUBLESHOOTING GUIDE
# =============================================================================

# STEP 1: Check your Doxyfile configuration
# These settings are CRITICAL for extracting internal comments:

INTERNAL_DOCS          = YES     # Must be YES to extract internal docs
HIDE_IN_BODY_DOCS      = NO      # Must be NO to show internal comments
SOURCE_BROWSER         = YES     # Enables source code display
INLINE_SOURCES         = YES     # Shows source with documentation
STRIP_CODE_COMMENTS    = NO      # Must be NO to preserve comments
EXTRACT_ALL            = YES     # Extract all documented/undocumented items
JAVADOC_AUTOBRIEF      = YES     # Helps with Java comment recognition

# STEP 2: Verify file paths and patterns
INPUT                  = ./src           # Make sure this path is correct
FILE_PATTERNS          = *.java         # Ensure .java files are included
RECURSIVE              = YES             # Search subdirectories

# STEP 3: Enable detailed warnings to see what's happening
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = doxygen_warnings.log  # Check this log file

# =============================================================================
# DIAGNOSTIC COMMANDS TO RUN
# =============================================================================

# 1. Test with verbose output to see what Doxygen is processing
doxygen -d Preprocessor Doxyfile

# 2. Check if your Java file is being found
doxygen -d ExtCmd Doxyfile

# 3. Generate with all debugging enabled
doxygen -d FilterOutput -d Validate Doxyfile

# 4. Check the warnings log for specific issues
cat doxygen_warnings.log

